{
  "name": "tanat",
  "version": "0.1.0",
  "private": true,
  "description": "Tanat — Embedded multi-tenant AI agents for SaaS, powered by NEAR",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "npm run build:worker && node scripts/local-api.mjs",
    "build:worker": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply tanat-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tanat-db --remote",
    "db:seed": "wrangler d1 execute tanat-db --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute tanat-db --remote --file=./scripts/seed.sql",
    "key:create": "node scripts/create-dev-key.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
